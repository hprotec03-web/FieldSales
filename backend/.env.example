# Copy to .env and fill in. NEVER commit the real .env.
ENVIRONMENT=development          # development | test | production
DEBUG=false

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FieldSales
DB_USER=fieldsales_app
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true   # set false in production with a valid server certificate

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false               # true when served over HTTPS (required in production)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Business rules ---
DUPLICATE_RULE=mobile             # mobile | name_mobile | name | off
DEFAULT_COUNTRY=United Arab Emirates

# --- Files ---
UPLOAD_DIR=uploads                # keep OUTSIDE any web-served/executable directory in production
MAX_UPLOAD_BYTES=5242880

# --- Demo seed only ---
SEED_PASSWORD=Demo@12345
